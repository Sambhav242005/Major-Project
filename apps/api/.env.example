# =============================================================================
# AI Knowledge Graph Builder — Backend (.env)
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Environment -----------------------------------------------------------
ENVIRONMENT=development

# --- Supabase --------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/.well-known/jwks.json

# --- Mock Auth (development only) -----------------------------------------
# Set to "true" to bypass Supabase JWT validation.
# NEVER set to "true" in production.
MOCK_AUTH=true

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/akgb

# --- ChromaDB (vector store) -----------------------------------------------
CHROMA_PATH=./chroma_data

# --- LLM -------------------------------------------------------------------
# Provider: "openai" or "ollama"
LLM_PROVIDER=openai

# OpenAI (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Ollama (required if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000"]
