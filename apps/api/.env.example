# =============================================================================
# AI Knowledge Graph Builder — Backend (.env)
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it may contain real secrets.
# If a real key was ever committed, rotate it immediately.
# =============================================================================

# --- Environment -----------------------------------------------------------
# development | production
# production + MOCK_AUTH=true is rejected at startup (fail-fast).
ENVIRONMENT=development

# --- Supabase --------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/.well-known/jwks.json

# --- Mock Auth (development only) -----------------------------------------
# Set to "true" to bypass Supabase JWT validation (accepts any token).
# NEVER set to "true" in production — the backend refuses to start, and the
# web app fails its production build if NEXT_PUBLIC_MOCK_AUTH=true.
MOCK_AUTH=true

# --- Database --------------------------------------------------------------
# Development is forced to SQLite (akgb.db). Production should use Postgres.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/akgb

# --- ChromaDB (vector store) -----------------------------------------------
CHROMA_PATH=./chroma_data

# --- LLM (OpenAI-compatible) -----------------------------------------------
# Groq example:  LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
# Ollama example: LLM_BASE_URL=http://localhost:11434/v1       LLM_MODEL=qwen3:4b-instruct
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:4b-instruct

# --- Embeddings (OpenAI-compatible) ------------------------------------------
# Groq example:  EMBEDDING_BASE_URL=https://api.groq.com/openai/v1
# Ollama example: EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=qwen3-embedding:4b

# --- Google Meet (client-side recorder — RECOMMENDED, no account needed) ------
# The Meetings page records the meeting tab's audio in YOUR browser and uploads
# it for transcription/analysis. No Google account, no bot, no extra setup.
# ffmpeg must be on PATH (the server converts webm/m4a to wav before
# transcribing).
# MEET_AUDIO_DIR=./meet_recordings

# --- Google Meet Bot agent (LEGACY — optional, requires a Google account) ------
# The google_meet agent type joins meetings as a bot via Playwright/CDP. It is
# NOT needed for the client-side recorder and needs a disposable Google account.
# RECOMMENDED: persistent Chrome profile (Playwright drives your installed
# Chrome via CDP with this profile — same as launch_persistent_context).
# Log into the dummy/bot Gmail ONCE by hand in this profile, close Chrome.
# The bot reuses the session every run — Google never sees automation login.
# MEET_CHROME_PROFILE=
# Fallback first-run login (Playwright fills Gmail credentials):
# MEET_EMAIL=
# MEET_PASSWORD=

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000"]
