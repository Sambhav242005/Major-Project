# =============================================================================
# AI Knowledge Graph Builder — Frontend (.env)
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================================

# --- Supabase (required for auth) -----------------------------------------
# Set local for private Pi accounts, supabase for managed Supabase Auth.
NEXT_PUBLIC_AUTH_PROVIDER=supabase
# Server-only address used by local auth proxy; never NEXT_PUBLIC.
# API_INTERNAL_URL=http://api:8000
# Optional, server-only; match the API AUTH_PROXY_SECRET behind a private gateway
# that overwrites X-AKGB-Client-IP and strips X-AKGB-Proxy-Secret on ingress.
# AUTH_PROXY_SECRET=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Mock Auth (development only) -----------------------------------------
# Set to "true" to bypass Supabase auth with a demo login cookie.
# NEVER set to "true" in production.
NEXT_PUBLIC_MOCK_AUTH="true"

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional server-only JSON array of exact login/logout origins. Invalid values
# fail closed. Unset defaults to NEXT_PUBLIC_APP_URL; never use a wildcard.
# AUTH_ALLOWED_ORIGINS=["http://localhost:3000"]
