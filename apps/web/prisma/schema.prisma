generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Document {
  id            String    @id @default(cuid())
  filename      String
  fileType      String
  status        String    @default("pending")
  storagePath   String?
  projectId     String
  pageCount     Int?
  chunkCount    Int?
  errorMessage  String?
  uploadedAt    DateTime  @default(now())
  processedAt   DateTime?

  chunks        Chunk[]

  @@index([projectId])
  @@index([status])
}

model Chunk {
  id            String    @id @default(cuid())
  documentId    String
  chunkIndex    Int
  pageNumber    Int?
  text          String
  tokenCount    Int
  chromaId      String?

  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([chromaId])
}
