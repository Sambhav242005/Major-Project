{
    auto_https disable_redirects
    skip_install_trust
    admin off
    default_sni {$LAN_IP:192.168.1.100}
}

(akgb_routes) {
    handle_path /api/* {
        reverse_proxy api:8000 {
            header_up -X-AKGB-Proxy-Secret
            header_up X-AKGB-Client-IP {remote_host}
        }
    }
    handle {
        reverse_proxy web:3000 {
            header_up -X-AKGB-Proxy-Secret
            header_up X-AKGB-Client-IP {remote_host}
        }
    }
}

https://{$LAN_IP:192.168.1.100} {
    tls internal
    import akgb_routes
}

https://{$PUBLIC_HOST:wg.pulkitworks.info} {
    # Set PUBLIC_TLS to the full-chain and key paths after DNS verification.
    # The persistent gateway volume holds the private key, never the image.
    tls {$PUBLIC_TLS:internal}
    import akgb_routes
}
