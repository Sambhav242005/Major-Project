# Copy to .env on the Pi; never commit the populated file.
# Generate POSTGRES_PASSWORD with: openssl rand -hex 32
# Use hex to keep the embedded asyncpg URL valid without percent-encoding.
POSTGRES_PASSWORD=

# LAN deployment; public DNS/routing remain operator-managed.
LAN_IP=192.168.1.100
APP_URL=https://192.168.1.100:9900
API_URL=https://192.168.1.100:9900/api
WEB_PORT=9900
API_PORT=9901

# Local accounts can be provisioned through the CLI; registration is opt-in.
AUTH_PROVIDER=local
LOCAL_AUTH_ALLOW_SIGNUP=false
# Generate separately with openssl rand -hex 32. Do not reuse database password.
LOCAL_AUTH_SECRET=
# Generate another independent openssl rand -hex 32 value for the web/API hop.
AUTH_PROXY_SECRET=
# Optional later: switch AUTH_PROVIDER=supabase and rebuild frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWKS_URL=

# ChatGPT uses a fresh official OAuth registration stored in the API volume.
# Do not paste existing Codex tokens. Select an account-available model after login.
LLM_PROVIDER=chatgpt
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=
LLM_EXTRACT_MODEL=

# Local CPU embeddings; choose a model once before initial ingestion.
# Model/dimension changes require re-embedding into a clean vector collection.
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
